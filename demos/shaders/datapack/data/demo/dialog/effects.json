{
    "type": "minecraft:multi_action",
    "title": {
        "text": "Demo: custom shaders",
        "color": "gold"
    },
    "body": [
        {
            "type": "minecraft:plain_message",
            "width": 420,
            "contents": {
                "text": "Build your own mix: one Look + any of the Mix-ins + Acid. Click an effect again to turn it off. Your current mix is shown on the action bar. Ready-made combos are under Presets.",
                "color": "gray"
            }
        },
        {
            "type": "minecraft:plain_message",
            "width": 420,
            "contents": {
                "text": "Mix-ins: pick one colour (Rainbow / Comic), one line style (Ink / Neon), and Wobble.",
                "color": "dark_gray"
            }
        }
    ],
    "actions": [
        {
            "label": {
                "text": "LOOK",
                "color": "dark_gray",
                "bold": true
            },
            "width": 72,
            "tooltip": {
                "text": "One at a time"
            }
        },
        {
            "label": {
                "text": "Reaper",
                "color": "white"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 1"
            },
            "tooltip": {
                "text": "Death vision. Black world, white outlines"
            }
        },
        {
            "label": {
                "text": "Cinematic",
                "color": "gold"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 2"
            },
            "tooltip": {
                "text": "Bloom, god rays, depth haze, filmic tone map, warm grade (the RTX feel)"
            }
        },
        {
            "label": {
                "text": "Thermal",
                "color": "aqua"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 3"
            },
            "tooltip": {
                "text": "Angel infrared vision. Cold world, glowing HP-coloured heat signatures (turns HP tags on)"
            }
        },
        {
            "label": {
                "text": "Cosmic",
                "color": "light_purple"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 4"
            },
            "tooltip": {
                "text": "Glowing stars with spikes, nebulae, starlight on the ground. Best at Midnight"
            }
        },
        {
            "label": {
                "text": "Monster",
                "color": "red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 5"
            },
            "tooltip": {
                "text": "Monster-class Hunger vision. Blood-red, short sight, hot rims, heartbeat"
            }
        },
        {
            "label": {
                "text": "MIX IN",
                "color": "dark_gray",
                "bold": true
            },
            "width": 72,
            "tooltip": {
                "text": "One colour, one line style, and Wobble"
            }
        },
        {
            "label": {
                "text": "Rainbow",
                "color": "light_purple"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 11"
            },
            "tooltip": {
                "text": "Colour: hue cycling with a ripple"
            }
        },
        {
            "label": {
                "text": "Comic",
                "color": "yellow"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 12"
            },
            "tooltip": {
                "text": "Colour: flat posterised colours, halftone shadows"
            }
        },
        {
            "label": {
                "text": "Ink",
                "color": "gray"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 21"
            },
            "tooltip": {
                "text": "Lines: dark comic-book outlines"
            }
        },
        {
            "label": {
                "text": "Neon",
                "color": "aqua"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 22"
            },
            "tooltip": {
                "text": "Lines: glowing cyan outlines"
            }
        },
        {
            "label": {
                "text": "Wobble",
                "color": "green"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 31"
            },
            "tooltip": {
                "text": "Screen wave + colour split (the v2 Acid)"
            }
        },
        {
            "label": {
                "text": "WORLD",
                "color": "dark_gray",
                "bold": true
            },
            "width": 72,
            "tooltip": {
                "text": "Bends the world itself, combines with everything"
            }
        },
        {
            "label": {
                "text": "Acid",
                "color": "dark_green"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 35"
            },
            "tooltip": {
                "text": "World warp: distant terrain waves and curls up over you, covering the sky. Near you stays still"
            }
        },
        {
            "label": {
                "text": "Presets...",
                "color": "yellow"
            },
            "width": 72,
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "demo:presets"
            },
            "tooltip": {
                "text": "Ready-made combinations (they replace your mix)"
            }
        },
        {
            "label": {
                "text": "Time, gallery",
                "color": "green"
            },
            "width": 72,
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "demo:world"
            },
            "tooltip": {
                "text": "Dawn / Noon / Dusk / Midnight, day cycle, gallery"
            }
        },
        {
            "label": {
                "text": "HP test",
                "color": "aqua"
            },
            "width": 72,
            "action": {
                "type": "minecraft:show_dialog",
                "dialog": "demo:hp_test"
            },
            "tooltip": {
                "text": "Hurt / heal / overheal yourself to test Thermal"
            }
        },
        {
            "label": {
                "text": "Clear all",
                "color": "red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 49"
            },
            "tooltip": {
                "text": "Turn every effect off"
            }
        },
        {
            "label": {
                "text": "REMOVE",
                "color": "dark_gray",
                "bold": true
            },
            "width": 72,
            "tooltip": {
                "text": "Turn off one category"
            }
        },
        {
            "label": {
                "text": "x Look",
                "color": "dark_red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 10"
            },
            "tooltip": {
                "text": "Remove the Look"
            }
        },
        {
            "label": {
                "text": "x Colour",
                "color": "dark_red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 19"
            },
            "tooltip": {
                "text": "Remove Rainbow / Comic"
            }
        },
        {
            "label": {
                "text": "x Lines",
                "color": "dark_red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 29"
            },
            "tooltip": {
                "text": "Remove Ink / Neon"
            }
        },
        {
            "label": {
                "text": "x Wobble",
                "color": "dark_red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 39"
            },
            "tooltip": {
                "text": "Remove Wobble"
            }
        },
        {
            "label": {
                "text": "x Acid",
                "color": "dark_red"
            },
            "width": 72,
            "action": {
                "type": "minecraft:run_command",
                "command": "trigger demo.fx set 38"
            },
            "tooltip": {
                "text": "Remove Acid"
            }
        }
    ],
    "columns": 6,
    "after_action": "none",
    "pause": false
}
