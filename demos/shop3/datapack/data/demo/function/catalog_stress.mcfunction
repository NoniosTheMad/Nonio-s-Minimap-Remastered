data modify storage nonios:shop nodes append value {"name":"Classes","up":0,"upg":0,"kind":"items","pages":[[{"n":552,"label":"Archer","ncol":"green","atlas":"minecraft:items","sprite":"minecraft:item/bow","price":50,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"Chainmail locked on, a bow that marks what it hits, a quiver that slowly refills. Stone tools, sandstone and carrots.\\n"},{"n":553,"label":"Miner","ncol":"gold","atlas":"minecraft:items","sprite":"minecraft:item/iron_pickaxe","price":80,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"Sees in the dark, digs faster, Block Pulverizer for bursts (it makes you glow). Leather locked on, torches, cobblestone and steak.\\n"},{"n":554,"label":"Tank","ncol":"dark_aqua","atlas":"minecraft:items","sprite":"minecraft:item/iron_chestplate","price":100,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"Iron locked on, shield locked in the off-hand, 2 extra hearts, hard to push. Ironskin flask: resistance and regeneration. Iron tools, stone, bread.\\n"},{"n":555,"label":"Ninja","ncol":"aqua","atlas":"minecraft:items","sprite":"minecraft:item/feather","price":100,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"No armour but the sandals: fast, light on its feet, runs on water. Genjutsu Booster: a few seconds invisible and very fast.\\n"},{"n":556,"label":"Berserker","ncol":"red","atlas":"minecraft:items","sprite":"minecraft:item/stone_axe","price":120,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"A battle axe that hits like a truck and makes you fast, unshakeable and regenerating. While it is out your armour counts for nothing.\\n"},{"n":557,"label":"Reaper","ncol":"dark_gray","atlas":"minecraft:items","sprite":"minecraft:item/netherite_hoe","price":200,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"Glass cannon. Scythe heals you on hit, kills give souls and a few seconds of invisibility, right-click releases the souls as a burst. 5 hearts, armour locked.\\n"},{"n":558,"label":"Monster","ncol":"dark_red","atlas":"minecraft:items","sprite":"minecraft:item/flint","price":1800,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"10 extra hearts, bigger, faster, claws that tear. Always starving: every kill is devoured for a burst of strength, speed and healing. No armour, locked skin.\\n"},{"n":559,"label":"Balrog","ncol":"gold","atlas":"minecraft:items","sprite":"minecraft:item/blaze_rod","price":10000,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"A Demon of Shadow and Fire from the Ancient times. Huge, 150 hearts, armour 20, fireproof, cannot jump but climbs walls. Its smoking trail curses enemies with wither.\\n"},{"n":560,"label":"Cracy Frog","ncol":"dark_purple","atlas":"minecraft:items","sprite":"minecraft:item/slime_ball","price":0,"count":1,"bulk":0,"sl":1,"unit":"","blurb":"#Useful. Huge jumps, a broom that (sort of) flies, a tongue that sends things anywhere. Leather armour locked on, and the world never stops melting.\\n"}]]}
