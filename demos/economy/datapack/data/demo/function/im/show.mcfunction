# with storage demo:im a: the picker dialog (actions = the 12 slots built in im/open)
$dialog show @s {type:"minecraft:multi_action",title:{text:"Interest modes",color:"gold"},body:{type:"minecraft:plain_message",width:320,contents:[{text:"Minute $(m)   $(team) $(b)   (live rate $(r))\n\n",color:"gray"},{text:"$(pA)A  ",color:"$(cA)",bold:true},{text:"$(As)/s",color:"white"},{text:"   1 min +$(Am)",color:"gold"},{text:"   cap $(Ks)/s\n",color:"gray"},{text:"$(pB)B  ",color:"$(cB)",bold:true},{text:"$(Bs)/s",color:"white"},{text:"   1 min +$(Bm)",color:"gold"},{text:"   no cap\n",color:"gray"},{text:"$(pC)C  ",color:"$(cC)",bold:true},{text:"$(Cs)/s",color:"white"},{text:"   1 min +$(Cm)",color:"gold"},{text:"   on <= $(base)\n\n",color:"gray"},{text:"Talisman x$(tm) on $(tv) = ",color:"green"},{text:"$(Ts)/s",color:"white"},{text:"   1 min +$(Tm)",color:"gold"},{text:"   (live mode, each holder)",color:"gray"}]},actions:$(acts),columns:4,pause:false,after_action:"wait_for_response",exit_action:{label:"Back",action:{type:"minecraft:run_command",command:"trigger demo.ec set 32"}}}
