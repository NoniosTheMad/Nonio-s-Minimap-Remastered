# upgrade available. Same layout in every state (ui/show_poor, ui/show_max): one action button + Close.
$dialog show @s {type:"minecraft:multi_action",title:{text:"$(name) generator",color:"$(col)"},body:{type:"minecraft:plain_message",width:200,contents:[{text:"Lv $(lvl) · regrows in $(sec)s\n",color:"yellow"},{text:"Purse: $(coins)",color:"gray"}]},columns:1,actions:[{label:[{text:"Upgrade to Lv $(next)  ",color:"green"},{text:"$(cost)",color:"gold"}],width:200,action:{type:"minecraft:run_command",command:"trigger nx.genup set 1"}}],exit_action:{label:"Close",width:200},pause:false}
