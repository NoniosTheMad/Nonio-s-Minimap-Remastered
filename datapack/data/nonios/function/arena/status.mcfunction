# as a player: print every node and the arena timers
tag @s add nx.ar_ask
tellraw @s [{text:"[arena] ",color:"aqua"},{text:"on ",color:"gray"},{score:{name:"#on",objective:"nx.arena"},color:"yellow"},{text:" | speed x",color:"gray"},{score:{name:"#speed",objective:"nx.arena"},color:"yellow"},{text:" | payout x",color:"gray"},{score:{name:"#mult",objective:"nx.arena"},color:"yellow"},{text:" | next event in ",color:"gray"},{score:{name:"#ev_t",objective:"nx.arena"},color:"yellow"},{text:" ticks (announced: fires in ",color:"gray"},{score:{name:"#ev_wait",objective:"nx.arena"},color:"yellow"},{text:", running: ",color:"gray"},{score:{name:"#ev_run",objective:"nx.arena"},color:"yellow"},{text:") | trolls ",color:"gray"},{score:{name:"#trolls",objective:"nx.arena"},color:"yellow"},{text:" | lightning ",color:"gray"},{score:{name:"#lt_on",objective:"nx.arena"},color:"yellow"}]
execute as @e[type=marker,tag=nx.node] run tellraw @a[tag=nx.ar_ask] [{text:"  ",color:"gray"},{entity:"@s",nbt:"data.label",color:"yellow"},{text:" (",color:"gray"},{entity:"@s",nbt:"data.bonus",color:"aqua"},{text:"): owner ",color:"gray"},{score:{name:"@s",objective:"nx.ar_own"},color:"white"},{text:" (0 none, 1 white, 2 black), progress ",color:"gray"},{score:{name:"@s",objective:"nx.ar_cap"},color:"white"},{text:", payout in ",color:"gray"},{score:{name:"@s",objective:"nx.ar_t"},color:"white"},{text:" ticks",color:"gray"}]
tellraw @s [{text:"  bonuses held: haste W",color:"gray"},{score:{name:"#haste_white",objective:"nx.arena"},color:"white"},{text:" B",color:"gray"},{score:{name:"#haste_black",objective:"nx.arena"},color:"white"},{text:" | interest W",color:"gray"},{score:{name:"#interest_white",objective:"nx.arena"},color:"white"},{text:" B",color:"gray"},{score:{name:"#interest_black",objective:"nx.arena"},color:"white"},{text:" | regrow W",color:"gray"},{score:{name:"#regrow_white",objective:"nx.arena"},color:"white"},{text:" B",color:"gray"},{score:{name:"#regrow_black",objective:"nx.arena"},color:"white"},{text:" | protection ",color:"gray"},{score:{name:"#prot",objective:"nx.arena"},color:"yellow"},{text:" (restores ",color:"gray"},{score:{name:"#restores",objective:"nx.arena"},color:"yellow"},{text:")",color:"gray"}]
tag @s remove nx.ar_ask
