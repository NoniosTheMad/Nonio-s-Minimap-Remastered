# as a player: gate state (open, active slot, next roll, uses since the last reset)
tellraw @s [{text:"[arena] gates ",color:"aqua"},{text:"open ",color:"gray"},{score:{name:"#gon",objective:"nx.arena"},color:"yellow"},{text:" | pads ",color:"gray"},{score:{name:"#gates",objective:"nx.arena"},color:"yellow"},{text:" | active slot ",color:"gray"},{score:{name:"#slot",objective:"nx.arena"},color:"yellow"},{text:"/",color:"gray"},{score:{name:"#slots",objective:"nx.arena"},color:"yellow"},{text:" | next roll in ",color:"gray"},{score:{name:"#g_t",objective:"nx.arena"},color:"yellow"},{text:" ticks | in ",color:"gray"},{score:{name:"#g_in",objective:"nx.arena"},color:"yellow"},{text:" out ",color:"gray"},{score:{name:"#g_out",objective:"nx.arena"},color:"yellow"}]
execute if entity @e[type=marker,tag=nx.aslot_on] run tellraw @s [{text:"  landing ",color:"gray"},{entity:"@e[type=marker,tag=nx.aslot_on,limit=1]",nbt:"data.land",color:"white"},{text:"  exit ",color:"gray"},{entity:"@e[type=marker,tag=nx.aslot_on,limit=1]",nbt:"data.exit",color:"white"}]
